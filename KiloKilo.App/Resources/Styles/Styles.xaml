<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:KiloKilo.Converters">

    <conv:FcfaConverter x:Key="FcfaConverter" />
    <conv:InvertBoolConverter x:Key="InvertBoolConverter" />

    <!-- ===== Pages ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Cream}, Dark={StaticResource DarkBg}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
    </Style>

    <!-- ===== Texte ===== -->
    <Style x:Key="LabelBase" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoSans" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource LabelBase}" />

    <Style x:Key="Eyebrow" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource DarkMuted}}" />
    </Style>
    <Style x:Key="Hero" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansExtraBold" />
        <Setter Property="FontSize" Value="30" />
    </Style>
    <Style x:Key="Heading" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansExtraBold" />
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="Subheading" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Strong" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansBold" />
    </Style>
    <Style x:Key="Muted" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource DarkMuted}}" />
    </Style>
    <Style x:Key="Accent" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryOnDark}}" />
    </Style>
    <Style x:Key="ErrorText" TargetType="Label" BasedOn="{StaticResource LabelBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
    </Style>

    <!-- ===== Cartes ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource DarkCard}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkPrimarySoft}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="WarnCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoft}, Dark={StaticResource DarkWarnSoft}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===== Champs ===== -->
    <Style x:Key="Input" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource DarkInput}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="NunitoSans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#A3A89F, Dark=#6E786F}" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="NunitoSans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#A3A89F, Dark=#6E786F}" />
    </Style>

    <!-- ===== Boutons ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="20,0" />
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryOnDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryOnDark}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryOnDark}}" />
        <Setter Property="FontFamily" Value="NunitoSansBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>
    <Style x:Key="DangerTextButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource DarkCard}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primary}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Primary}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
    </Style>
    <Style TargetType="BoxView" x:Key="Divider">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>
</ResourceDictionary>
