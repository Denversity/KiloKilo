<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="KiloKilo.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:KiloKilo.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!-- Authentification -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="register" ContentTemplate="{DataTemplate views:RegisterPage}" />

    <!-- Application : la barre d'onglets native est masquée, remplacée par Controls/BottomNavBar -->
    <TabBar Route="main">
        <ShellContent Title="Accueil" Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Historique" Route="historique" ContentTemplate="{DataTemplate views:HistoriquePage}" />
        <ShellContent Title="Prix" Route="prix" ContentTemplate="{DataTemplate views:ProduitsPage}" />
        <ShellContent Title="Stats" Route="stats" ContentTemplate="{DataTemplate views:StatsPage}" />
        <ShellContent Title="Profil" Route="profil" ContentTemplate="{DataTemplate views:ProfilPage}" />
    </TabBar>
</Shell>
