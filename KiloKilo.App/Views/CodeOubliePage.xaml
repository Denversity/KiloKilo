<?xml version="1.0" encoding="utf-8" ?>
<views:ResponsivePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KiloKilo.Views"
    x:Class="KiloKilo.Views.CodeOubliePage"
    Shell.TabBarIsVisible="False"
    MaxContentWidth="480">

    <ScrollView>
        <VerticalStackLayout x:Name="Host" Padding="24,24,24,32" Spacing="20">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button Text="←" Style="{StaticResource TextButton}" FontSize="22" WidthRequest="44" Padding="0"
                        Command="{Binding RetourCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Connexion" Style="{StaticResource Eyebrow}" />
                    <Label Text="Code oublié ?" Style="{StaticResource Heading}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}" IsVisible="{Binding Etape1}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Indiquez votre téléphone ou votre e-mail : nous vous enverrons un code pour choisir un nouveau PIN."
                           Style="{StaticResource Muted}" />
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Identifiant ou téléphone" Style="{StaticResource Eyebrow}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Placeholder="Ex: +237 690 00 00 00 ou e-mail" Text="{Binding Identifiant}" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="{Binding Erreur}" IsVisible="{Binding HasErreur}" Style="{StaticResource ErrorText}" />
                    <Button Text="Envoyer le code" Style="{StaticResource PrimaryButton}"
                            Command="{Binding EnvoyerCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding Etape2}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Message}" Style="{StaticResource Muted}" />
                    <Border Style="{StaticResource SoftCard}" Padding="12" IsVisible="{Binding HasCodeTest}">
                        <Label Text="{Binding CodeTest}" Style="{StaticResource Accent}" FontSize="13" />
                    </Border>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Code reçu (6 chiffres)" Style="{StaticResource Eyebrow}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding Code}" Keyboard="Numeric" MaxLength="6" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nouveau code secret (4 chiffres)" Style="{StaticResource Eyebrow}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding NouveauPin}" IsPassword="True" MaxLength="4" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="{Binding Erreur}" IsVisible="{Binding HasErreur}" Style="{StaticResource ErrorText}" />
                    <Button Text="Changer mon code secret" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReinitialiserCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:ResponsivePage>
