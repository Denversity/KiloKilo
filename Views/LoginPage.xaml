<?xml version="1.0" encoding="utf-8" ?>
<views:ResponsivePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KiloKilo.Views"
    x:Class="KiloKilo.Views.LoginPage"
    Shell.TabBarIsVisible="False"
    MaxContentWidth="480">

    <ScrollView>
        <VerticalStackLayout x:Name="Host" HorizontalOptions="Center" Padding="24,40,24,32" Spacing="22">

            <!-- Marque -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
                    <Label Text="K" TextColor="White" FontFamily="NunitoSansExtraBold" FontSize="32"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="KiloKilo" Style="{StaticResource Hero}" HorizontalOptions="Center" />
                <Label Text="Espace protégé • Mode hors-ligne actif" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Connexion" Style="{StaticResource Heading}" />
                <Label Text="Retrouvez vos courses et prix enregistrés au quotidien." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Identifiant ou téléphone" Style="{StaticResource Eyebrow}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Placeholder="Ex: +237 690 00 00 00 ou e-mail" Text="{Binding Identifiant}" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Code secret (PIN)" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Code oublié ?" Style="{StaticResource TextButton}"
                                    HeightRequest="28" Command="{Binding CodeOublieCommand}" />
                        </Grid>
                        <Border Style="{StaticResource Input}">
                            <Entry Placeholder="••••" Text="{Binding Pin}" IsPassword="True" MaxLength="4" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding Memoriser}" VerticalOptions="Center" />
                        <Label Text="Mémoriser sur cet appareil pour le marché" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Erreur}" IsVisible="{Binding HasErreur}" Style="{StaticResource ErrorText}" />

                    <Button Text="Accéder à mes courses" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnexionCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <BoxView Style="{StaticResource Divider}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="OU ACCÈS DIRECT" Style="{StaticResource Eyebrow}" />
                <BoxView Grid.Column="2" Style="{StaticResource Divider}" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Button Text="Connexion par empreinte" Style="{StaticResource OutlineButton}" Command="{Binding EmpreinteCommand}" />
                <Button Text="Mode hors-ligne direct (au marché)" Style="{StaticResource TextButton}" Command="{Binding HorsLigneCommand}" />
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                <Label Text="Nouveau sur KiloKilo ?" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Button Text="Créer un compte" Style="{StaticResource TextButton}" Command="{Binding CreerCompteCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:ResponsivePage>
