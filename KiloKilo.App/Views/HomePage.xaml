<?xml version="1.0" encoding="utf-8" ?>
<views:ResponsivePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KiloKilo.Views"
    xmlns:controls="clr-namespace:KiloKilo.Controls"
    xmlns:vm="clr-namespace:KiloKilo.ViewModels"
    x:Class="KiloKilo.Views.HomePage"
    MaxContentWidth="960">

    <Grid RowDefinitions="*,Auto">
    <ScrollView>
        <Grid x:Name="Host" Padding="20,20,20,28"
              ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Wide">
                        <VisualState.Setters>
                            <Setter TargetName="LeftPane" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="RightPane" Property="Grid.Row" Value="0" />
                            <Setter TargetName="RightPane" Property="Grid.Column" Value="1" />
                            <Setter TargetName="RightPane" Property="Grid.ColumnSpan" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Colonne gauche : en-tête, enveloppe mensuelle, action principale -->
            <VerticalStackLayout x:Name="LeftPane" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16">
                <Border Style="{StaticResource WarnCard}" Padding="12,10" IsVisible="{Binding HasSyncMessage}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BandeauSyncCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding SyncMessage}" FontSize="12" FontFamily="NunitoSansSemiBold" />
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MoisLabel}" Style="{StaticResource Eyebrow}" />
                        <Label Style="{StaticResource Heading}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Bonjour " />
                                    <Span Text="{Binding Prenom}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="KiloKilo • Marché frais" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24"
                            StrokeThickness="2" Stroke="{StaticResource Primary}" VerticalOptions="Start">
                        <Image Source="avatar_amina.jpg" Aspect="AspectFill" />
                    </Border>
                </Grid>

                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Enveloppe mensuelle" Style="{StaticResource Eyebrow}" TextColor="#D6E6DB" />
                        <Label Text="{Binding EnveloppeAffichee}" FontFamily="NunitoSansExtraBold" FontSize="26" TextColor="White" />
                        <ProgressBar Progress="{Binding Progression}" ProgressColor="White" BackgroundColor="#6F9A7C" HeightRequest="8" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Consommé" TextColor="#D6E6DB" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding ConsommeAffiche}" TextColor="White" FontFamily="NunitoSansBold" FontSize="13" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#6F9A7C" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <Label Text="Panier moyen" TextColor="#D6E6DB" FontSize="12" />
                            <Label Grid.Row="1" Text="{Binding PanierMoyenAffiche}" TextColor="White" FontFamily="NunitoSansBold" />
                            <Label Grid.Column="1" Text="Données locales à jour" TextColor="#D6E6DB" FontSize="12" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding NbCoursesAffiche}" TextColor="White" FontFamily="NunitoSansBold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="+  Enregistrer un panier" Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource PrimaryOnDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource DarkBg}}"
                        Command="{Binding EnregistrerPanierCommand}" />

                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" HeightRequest="110">
                    <Grid>
                        <Image Source="marche_panier.jpg" Aspect="AspectFill" />
                        <BoxView Color="#66000000" />
                        <Label Text="Des prix justes, relevés par vos voisins." TextColor="White" FontFamily="NunitoSansBold"
                               FontSize="15" Margin="16" VerticalOptions="End" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Colonne droite : dernières courses et repères -->
            <VerticalStackLayout x:Name="RightPane" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Dernières courses" Style="{StaticResource Subheading}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Tout voir" Style="{StaticResource TextButton}" Command="{Binding ToutVoirCommand}" />
                </Grid>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DernieresCourses}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OuvrirCourseCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkPrimarySoft}}">
                                        <Label Text="🧺" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Marche}" Style="{StaticResource Strong}" />
                                        <Label Text="{Binding Resume}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding TotalAffiche}" Style="{StaticResource Strong}" HorizontalOptions="End" />
                                        <Label Text="{Binding DateAffichee}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource SoftCard}" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoirPrixCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Indice vivres" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding IndiceVivres}" Style="{StaticResource Heading}" />
                            <Label Text="{Binding IndiceVivresDetail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource WarnCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Repère saison" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding RepereSaison}" Style="{StaticResource Subheading}" />
                            <Label Text="{Binding RepereSaisonDetail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
    <controls:BottomNavBar Grid.Row="1" Active="home" />
    </Grid>
</views:ResponsivePage>
