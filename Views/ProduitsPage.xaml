<?xml version="1.0" encoding="utf-8" ?>
<views:ResponsivePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KiloKilo.Views"
    xmlns:controls="clr-namespace:KiloKilo.Controls"
    xmlns:vm="clr-namespace:KiloKilo.ViewModels"
    x:Class="KiloKilo.Views.ProduitsPage"
    MaxContentWidth="720">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout x:Name="Host" Padding="20,20,20,28" Spacing="16">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Repères de prix" Style="{StaticResource Eyebrow}" />
                    <Label Text="Prix des produits" Style="{StaticResource Heading}" />
                    <Label Text="Suivez ce que vous payez, produit par produit, dans le temps." Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource SoftCard}" Padding="16,14">
                    <Label Text="{Binding Resume}" Style="{StaticResource Accent}" />
                </Border>

                <Border Style="{StaticResource Input}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="🔍" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Rechercher un produit..." Text="{Binding Recherche}" ReturnType="Search" />
                    </Grid>
                </Border>

                <controls:ChipBar ItemsSource="{Binding Filtres}" Command="{Binding ChoisirFiltreCommand}" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Produits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OuvrirCommand, Source={RelativeSource AncestorType={x:Type vm:ProduitsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                        <Image Source="{Binding Photo}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nom}" Style="{StaticResource Strong}" />
                                        <Label Text="{Binding SousTitre}" Style="{StaticResource Muted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding PrixActuelAffiche}" Style="{StaticResource Strong}" HorizontalOptions="End" />
                                        <Label Text="{Binding VariationAffichee}" Style="{StaticResource Muted}" FontFamily="NunitoSansBold"
                                               FontSize="12" HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding EnBaisse}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding EnHausse}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Aucun produit ne correspond." IsVisible="{Binding AucunResultat}"
                       Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource WarnCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Astuce KiloKilo" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Warn}" />
                        <Label Text="Les prix sont ramenés à l'unité saisie (kg, seau, tas…). Indiquez toujours la quantité pour comparer vos relevés." FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomNavBar Grid.Row="1" Active="prix" />
    </Grid>
</views:ResponsivePage>
